# ─── Supabase ────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: mock | gemini | openai
# Default "mock" works with no API key — returns template-based styling tips
LLM_PROVIDER=mock

# Uncomment + fill in when you have an API key:
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local dev:    http://localhost:5500
# Production:   your Vercel URL e.g. https://sanora.vercel.app
FRONTEND_URL=http://localhost:5500
